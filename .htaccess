# =============================================================================
# WiNKATO – Apache-Konfiguration
# Für klassische Webhoster (All-Inkl, IONOS, Strato, webgo …).
# Läuft die Seite auf Vercel oder Netlify, wird diese Datei ignoriert –
# dort greift vercel.json.
# =============================================================================

# ------------------------------------------------------------ Weiterleitungen
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Immer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Immer www – eine einzige gültige Adresse statt vier
  #    (Wer lieber OHNE www fahren will: diesen Block auskommentieren
  #     und stattdessen den darunter aktivieren.)
  RewriteCond %{HTTP_HOST} ^winkato\.de$ [NC]
  RewriteRule ^ https://www.winkato.de%{REQUEST_URI} [R=301,L]

  # Variante ohne www – nur aktivieren, wenn oben deaktiviert wurde,
  # und dann in allen HTML-Dateien, sitemap.xml und robots.txt
  # "https://www.winkato.de" durch "https://winkato.de" ersetzen.
  # RewriteCond %{HTTP_HOST} ^www\.winkato\.de$ [NC]
  # RewriteRule ^ https://winkato.de%{REQUEST_URI} [R=301,L]

  # 3. /index.html -> / (sonst zwei Adressen für dieselbe Startseite)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 4. Alte Anker-Adressen der bisherigen One-Page-Seite auf die neuen Seiten
  RewriteRule ^wappen/?$ /familienwappen.html [R=301,L]
  RewriteRule ^winkatos/?$ /eichsfeld-unikate.html [R=301,L]
  RewriteRule ^about/?$ /ueber-mich.html [R=301,L]
  RewriteRule ^widerrufsrecht\.html$ /widerruf.html [R=301,L]
</IfModule>

# ----------------------------------------------------------------- Fehlerseite
ErrorDocument 404 /404.html

# ------------------------------------------------------------------ Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------- Caching
<IfModule mod_expires.c>
  ExpiresActive On

  # Bilder, Schriften und Video ändern sich praktisch nie
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"

  # CSS/JS eine Woche – lang genug für Tempo, kurz genug für Änderungen
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"

  # HTML nie lange cachen, sonst sehen Besucher alte Preise
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ---------------------------------------------------------- Sicherheit
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS erst aktivieren, wenn HTTPS zuverlässig läuft (Rückweg ist mühsam):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --------------------------------------------------------------- MIME-Typen
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Verzeichnislisten abschalten
Options -Indexes
